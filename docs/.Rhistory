# Define Sigma and Delta
Sigma <- matrix(c(2, 0,
0, 1), nrow = 2, byrow = TRUE)
Delta <- c(1, 1)
rho <- 1
# Compute updated covariance
CovX <- Sigma + rho * (Delta %*% t(Delta))
# Eigen decomposition
eig <- eigen(CovX)
lambda1 <- eig$values[1]
v1 <- eig$vectors[,1]
# Compute the claimed formula: (Sigma - lambda1 * I)^{-1} * Delta
Sigma_shifted <- Sigma - lambda1 * diag(2)
v_claimed <- solve(Sigma_shifted, Delta)
# Normalize both vectors
v1_normalized <- v1 / sqrt(sum(v1^2))
v_claimed_normalized <- v_claimed / sqrt(sum(v_claimed^2))
# Output
cat("Top eigenvector of Cov(X):\n")
print(v1_normalized)
cat("\nClaimed vector (inverted shifted Sigma applied to Delta):\n")
print(v_claimed_normalized)
cat("\nAre the directions proportional? (correlation):\n")
print(cor(v1_normalized, v_claimed_normalized))
