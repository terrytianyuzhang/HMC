# Parameters
n_max <- 200
d <- 10
lambda <- 1e-3  # Ridge regularization
norm_vals <- numeric(n_max - 1)
# Sample all Xs
X_all <- array(rnorm(n_max * d), dim = c(n_max, d))
# Helper to get regularized Gram matrix inverse
inv_gram <- function(X) {
r <- nrow(X)
Sigma <- crossprod(X) / r + lambda * diag(d)
solve(Sigma)
}
# Loop through r = 2 to n_max
for (r in 10:n_max) {
# Take first r samples
X <- X_all[1:r, , drop = FALSE]
# Choose i and l (arbitrary, distinct)
i <- 1
l <- 2
# Construct Sigma_{r-1}^{-1}
X0 <- X[-r, , drop = FALSE]
S0_inv <- inv_gram(X0)
# Replace l-th sample
X_l <- X0
X_l[l, ] <- rnorm(d)
Sl_inv <- inv_gram(X_l)
# Replace i-th sample
X_i <- X0
X_i[i, ] <- rnorm(d)
Si_inv <- inv_gram(X_i)
# Replace both i and l
X_il <- X0
X_il[i, ] <- rnorm(d)
X_il[l, ] <- rnorm(d)
Sil_inv <- inv_gram(X_il)
# Compute norm
diff <- S0_inv - Sl_inv - Si_inv + Sil_inv
norm_vals[r - 1] <- norm(diff, type = "2")
}
# Plot norm vs. r
plot(2:n_max, norm_vals, type = "l", lwd = 2,
xlab = "r", ylab = "Operator norm",
main = "Decay of ||Sigma^{-1} - Sl^{-1} - Si^{-1} + Sil^{-1}||")
set.seed(123)
# Parameters
n_max <- 200
d <- 10
lambda <- 1e-3  # Ridge regularization
norm_vals <- numeric(n_max - 1)
# Sample all Xs
X_all <- array(rnorm(n_max * d), dim = c(n_max, d))
# Helper to get regularized Gram matrix inverse
inv_gram <- function(X) {
r <- nrow(X)
Sigma <- crossprod(X) / r + lambda * diag(d)
solve(Sigma)
}
# Loop through r = 2 to n_max
for (r in 10:n_max) {
# Take first r samples
X <- X_all[1:r, , drop = FALSE]
# Choose i and l (arbitrary, distinct)
i <- 1
l <- 2
# Construct Sigma_{r-1}^{-1}
X0 <- X[-r, , drop = FALSE]
S0_inv <- inv_gram(X0)
# Replace l-th sample
X_l <- X0
X_l[l, ] <- rnorm(d)
Sl_inv <- inv_gram(X_l)
# Replace i-th sample
X_i <- X0
X_i[i, ] <- rnorm(d)
Si_inv <- inv_gram(X_i)
# Replace both i and l
X_il <- X0
X_il[i, ] <- rnorm(d)
X_il[l, ] <- rnorm(d)
Sil_inv <- inv_gram(X_il)
# Compute norm
diff <- S0_inv - Sl_inv - Si_inv + Sil_inv
norm_vals[r - 1] <- norm(diff, type = "2")
}
# Plot norm vs. r
plot(log(2:n_max), log(norm_vals), type = "l", lwd = 2,
xlab = "r", ylab = "Operator norm",
main = "Decay of ||Sigma^{-1} - Sl^{-1} - Si^{-1} + Sil^{-1}||")
